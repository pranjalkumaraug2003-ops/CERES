# CERES backend config. Copy to server/.env and fill in.
#   cp server/.env.example server/.env
# server/.env is gitignored — never commit real keys.

# ── LLM provider chain (failover order, highest priority first) ───────────────
# The router tries each in order and skips any without a credential, so an
# unset key costs nothing. A provider that fails is benched by a circuit
# breaker (cooldown doubles on repeat failure) instead of being retried on
# every request.
#
# Valid names: groq, cerebras, github-models, openrouter, deepseek, together,
#              gemini, gemini-pro, mistral, openai, anthropic, ollama
#
# Default is free-tier-first. Add `gemini` earlier in the list once you have a
# Google key, or drop any name you don't have a credential for.
LLM_PROVIDER_CHAIN=groq,openrouter,cerebras,gemini

# ── FREE tiers — start here, no billing setup, no card ───────────────────────

# Groq — fastest tokens/sec of any host (best for voice). Generous free tier.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras — free tier, also extremely fast. NOTE: some accounts return HTTP
# 402 until billing is enabled, even on the free plan. Only 3 models offered;
# gpt-oss-120b is the tool-calling one (gemma has no native function calling).
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# GitHub Models — free with any GitHub account, and part of the GitHub Student
# Developer Pack. Uses a plain personal access token; zero billing setup.
# https://github.com/marketplace/models   (token: https://github.com/settings/tokens)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini
# Override if GitHub moves the endpoint (a 404 means it moved):
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# ── CHEAP prepaid — small top-ups, no large upfront commitment ───────────────

# OpenRouter — one key reaches most models INCLUDING Gemini, so you can use
# Gemini without a Google billing account. Small prepaid top-up.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# DeepSeek — among the cheapest capable models anywhere; good tool calling.
# Requires a balance; returns HTTP 402 'Insufficient Balance' at zero.
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Together.ai — free starting credits, then cheap per-token.
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── Google Gemini — free tier works; paid tier may require a billing account ─
# https://aistudio.google.com/apikey
# If the paid upgrade demands a large upfront balance, use OpenRouter's
# `google/gemini-2.5-flash` above instead — same model, small top-up.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ── Optional extra providers (leave blank to skip) ───────────────────────────
# Anthropic — most reliable at structured tool calling. Paid only; note a
# Claude Pro subscription does NOT include API access. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://console.mistral.ai — free tier
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Local / offline last resort (no API key needed) ──────────────────────────
# Add `ollama` to the end of LLM_PROVIDER_CHAIN to enable. Expect slow
# time-to-first-token on CPU-only hardware — prompt prefill is compute-bound,
# so this is an offline fallback, not a primary path for voice.
# Use a tool-calling-capable model: qwen2.5 or llama3.1. Gemma has no native
# function-calling training and will not drive CERES's tool pipeline.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Datastores (required) ────────────────────────────────────────────────────

# Vector memory. Qdrant Cloud free tier, or http://localhost:6333 for local.
QDRANT_URL=
QDRANT_API_KEY=

# Session history + intent cache. redis://localhost:6379 for local.
# Falls back to in-process memory if unset, so this is not strictly fatal.
REDIS_URL=

# Postgres for the command-history table (asyncpg driver).
# postgresql+asyncpg://user:password@host:5432/ceres
DATABASE_URL=

# ── On-device model toggles ──────────────────────────────────────────────────
# Both default to false (cloud path). Set true only after installing
# requirements-local.txt. Local = private and no API cost, but uses CPU.

USE_LOCAL_STT=false               # faster-whisper instead of cloud STT
USE_LOCAL_TTS=false               # kokoro instead of Gemini TTS

# ── Not currently read by any code ──────────────────────────────────────────
# Kept as a record of what was wired up but never finished.

# Intended off switch for the embedding intent router, but never implemented —
# qdrant_service.py loads SentenceTransformer unconditionally at import, so the
# router is always on. Setting this has no effect today.
# USE_LOCAL_ROUTER=true

# Intended router threshold; the value is hardcoded to 0.20 in
# server/services/local_router_service.py instead.
# ROUTER_CONFIDENCE_THRESHOLD=0.20

# Dead flag from the pre-V2 LangGraph build.
# LEGACY_MODE=false

# Unused. No code reads a HuggingFace token; model downloads are anonymous.
# HF_TOKEN=

# LangSmith tracing from the earlier LangGraph build. Superseded by the
# hand-rolled tracer in server/core/tracer.py.
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=
# LANGCHAIN_PROJECT=
